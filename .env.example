MC_PANEL_ENV=development
MC_PANEL_BIND=127.0.0.1
MC_PANEL_PORT=18080
MC_PANEL_DATABASE_PATH=./data/panel.db
MC_PANEL_WEB_DIST_PATH=./apps/web/dist
MC_PANEL_ADAPTER=mock
MC_PANEL_SECRET_KEY=
MC_PANEL_PUBLIC_ORIGIN=
MC_PANEL_SERVER_NAME="我的 Minecraft 服务器"
MC_PANEL_PUBLIC_ADDRESS=
MC_PANEL_SERVER_ROOT=/srv/minecraft/server
MC_PANEL_SERVER_STARTUP_PATH=/srv/minecraft/server/start.sh
MC_PANEL_SERVER_SERVICE=minecraft.service
MC_PANEL_SERVER_PORT=25565
MC_PANEL_SERVER_TIMEZONE=UTC
MC_PANEL_BACKUP_ROOT=/srv/minecraft/backups
MC_PANEL_BACKUP_ARCHIVE_GLOB=minecraft-*.tar.gz
MC_PANEL_BACKUP_SERVICE=minecraft-backup.service
MC_PANEL_BACKUP_TIMER=minecraft-backup.timer
MC_PANEL_BACKUP_COMMAND=/usr/local/bin/minecraft-backup
MC_PANEL_BACKUP_TIMER_UNIT_PATH=/etc/systemd/system/minecraft-backup.timer
MC_PANEL_BACKUP_TIMER_DROPIN_PATH=/etc/systemd/system/minecraft-backup.timer.d/mc-panel.conf
MC_PANEL_BACKUP_SERVICE_UNIT_PATH=/etc/systemd/system/minecraft-backup.service
MC_PANEL_BACKUP_SERVICE_DROPIN_PATH=/etc/systemd/system/minecraft-backup.service.d/mc-panel.conf
MC_PANEL_RECOVERY_ROOT=/srv/minecraft/panel-recovery
MC_PANEL_CONSOLE_USER=minecraft
MC_PANEL_CONSOLE_SCREEN=minecraft
MC_PANEL_HELPER_CONFIG_PATH=/etc/mc-panel/helper.json
MC_PANEL_MINECRAFT_VERSION=
MC_PANEL_LOADER=
MC_PANEL_LOADER_VERSION=
MC_PANEL_JAVA_VERSION=
MC_PANEL_APPROVED_FINGERPRINT=
MC_PANEL_PRODUCTION_WRITES_ENABLED=false
MC_PANEL_HELPER_PATH=/usr/local/libexec/mc-panel-action
MC_PANEL_AI_ENABLED=false
MC_PANEL_AI_API_BASE_URL=
MC_PANEL_AI_API_KEY=
MC_PANEL_AI_MODEL=
MC_PANEL_AI_TEMPERATURE=0.2
MC_PANEL_AI_MAX_TOKENS=800
MC_PANEL_AI_TIMEOUT_SECONDS=30
MC_PANEL_AI_REQUESTS_PER_MINUTE=3
MC_PANEL_AI_REQUESTS_PER_DAY=40
MC_PANEL_AI_TOKENS_PER_DAY=30000
